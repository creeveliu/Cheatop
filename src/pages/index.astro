---
import { getCollection } from "astro:content";
import ToolCard from "../components/ToolCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = await getCollection("tools");

function getCardSummary(title: string, summary: string) {
  return summary.startsWith(`${title} `)
    ? summary.slice(title.length).trimStart()
    : summary;
}
---

<BaseLayout title="AI Cheat Sheets">
  <section class="directory-hero">
    <p class="directory-kicker">Engineer&apos;s Index</p>
    <h1>AI Tool Cheat Sheets</h1>
    <p class="directory-dek">为工程师准备的深色速查索引。优先快速定位安装方式、核心命令、flags、快捷键与高频工作流。</p>
  </section>
  <section class="directory-meta">
    <p>当前重点：高密度 cheatsheet，兼顾屏幕阅读与打印输出。</p>
    <p>当前收录：Claude Code CLI 中文速查表。</p>
  </section>
  <section class="tool-grid">
    {tools.map((tool) => (
      <ToolCard
        title={tool.data.title}
        summary={getCardSummary(tool.data.title, tool.data.summary)}
        href={`/tools/${tool.slug}/`}
        category={tool.data.category}
      />
    ))}
  </section>
</BaseLayout>
